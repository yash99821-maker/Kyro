# ---------------------------------------------------------------
# KYRO backend environment variables
# Copy this file to `.env` and fill in your own values.
# NEVER commit a real .env file.
# ---------------------------------------------------------------

# MongoDB connection string.
# Local install:  mongodb://127.0.0.1:27017/kyro
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>/kyro?retryWrites=true&w=majority
#
# If this is left EMPTY, KYRO automatically starts a local embedded MongoDB
# server (mongodb-memory-server) and stores its data files in server/.mongo-data
# so your demo data survives restarts. See README "MongoDB setup".
MONGODB_URI=

# OFFLINE MACHINES ONLY (e.g. a college lab PC with no internet).
# The embedded MongoDB normally downloads a mongod binary (~62 MB) on first
# run. If that machine has no internet, copy the binary from a machine that
# does (it lives in <home>/.cache/mongodb-binaries/) and point this at it.
# The binary is OS-specific: a Windows one only works on Windows.
# Leave this blank on any machine with internet.
MONGOMS_SYSTEM_BINARY=

# Secret used to sign JWT authentication tokens. Use a long random string.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# API server port
PORT=5000

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

NODE_ENV=development
